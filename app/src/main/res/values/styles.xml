<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B994FF</item>
        <item name="android:statusBarColor">#111015</item>
        <item name="android:navigationBarColor">#111015</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/MyControlDialog</item>
    </style>
    <style name="MyControlDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#1D1B24</item>
        <item name="android:textColorPrimary">#F6F2FA</item>
        <item name="android:textColorSecondary">#AAA3B5</item>
        <item name="android:colorAccent">#B994FF</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>